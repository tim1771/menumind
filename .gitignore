# Local Netlify folder
.netlify

# Environment variables — never commit
.env
.env.local
.env*.local

# Dependencies
node_modules/

# Blog source artifacts (markdown is the source of truth)
blogposts.zip

# Generated blog HTML — regenerated on deploy by scripts/build-blog.js
blog/*.html
fr/blog/*.html

# Generated city landing pages — regenerated on deploy by scripts/build-cities.js
audit/*.html

# Generated sitemap — regenerated on deploy by scripts/build-sitemap.js
sitemap.xml
